<launch>

  <arg name="config" />
  <!-- Set visualize:=false for headless data generation (e.g. on macOS, where
       the dvs_renderer viewer node aborts on the robostack librospack/libpython
       issue). esim_node still writes the rosbag regardless. -->
  <arg name="visualize" default="true" />

  <!-- Event camera simulator -->
  <node name="esim_node" pkg="esim_ros" type="esim_node" args="
    --v=1
    --vmodule=data_provider_from_folder=10
    --flagfile=$(find esim_ros)/$(arg config)
    " output="screen"/>

  <group if="$(arg visualize)">
    <include file="$(find esim_ros)/launch/visualization.launch" />
  </group>


</launch>
